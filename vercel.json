{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist/client",
  "cleanUrls": true,
  "trailingSlash": false,
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": false,
      "redesign-2026": true,
      "feature/**": true
    }
  },
  "redirects": [
    {
      "source": "/_files/ugd/ffdbc4_b7f37e5672f54b16a7713675a68249fd.pdf",
      "destination": "/documents/non-discrimination-statement.pdf",
      "permanent": true
    },
    {
      "source": "/_files/ugd/ffdbc4_9c90c2418eef4d0da44f142484523681.pdf",
      "destination": "/documents/volunteer-application.pdf",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "Vary",
          "value": "RSC"
        }
      ]
    },
    {
      "source": "/(.*)\\.rsc",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/x-component"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "preview.projectstarburst.org"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/plm-preview",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors https://plm-website-git-fix-os-site-editor-entry-platinum-luxe-media.vercel.app"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "^/$",
      "has": [
        {
          "type": "header",
          "key": "rsc",
          "value": "1"
        }
      ],
      "dest": "/index.rsc",
      "headers": {
        "Content-Type": "text/x-component",
        "Cache-Control": "private, no-store",
        "Vary": "RSC",
        "X-Robots-Tag": "noindex"
      }
    },
    {
      "src": "^/about-us$",
      "has": [
        {
          "type": "header",
          "key": "rsc",
          "value": "1"
        }
      ],
      "dest": "/about-us.rsc",
      "headers": {
        "Content-Type": "text/x-component",
        "Cache-Control": "private, no-store",
        "Vary": "RSC",
        "X-Robots-Tag": "noindex"
      }
    },
    {
      "src": "^/contact$",
